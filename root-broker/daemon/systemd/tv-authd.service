# Install this unit source at /opt/tv-units/tv-authd.service.
# The AT-HUB boot hook copies it into /run/systemd/system and starts it.
[Unit]
Description=tv-authd privilege broker
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
# app_launcher/AUL use the runtime directory; keep this explicit even though
# systemd currently supplies it on this firmware.
Environment=XDG_RUNTIME_DIR=/run
Environment=HOME=/root
ExecStartPre=/bin/sh -c "mkdir -p /run/tv-auth"
# /opt is on the signed VDFS, where the kernel UEP gate rejects unsigned ELFs.
# Expose the broker binary under /run (outside UEP's checked prefixes) with a
# per-service read-only bind mount instead of copying it in. The daemon still
# reads and rewrites grants.json at its real path (/opt/tv-auth), which stays
# writable; only the /run/opt/... view is read-only.
BindReadOnlyPaths=/opt/tv-auth:/run/opt/tv-auth
ExecStart=/run/opt/tv-auth/tv-authd --socket /run/tv-auth/broker.sock --grants /opt/tv-auth/grants.json --log /run/tv-auth/tv-authd.log --socket-gid 100
Restart=always
RestartSec=1

[Install]
# The systemd unit path is read-only; this section is documentation only.
WantedBy=multi-user.target
