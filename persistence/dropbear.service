# Root-owned extra systemd unit for Dropbear.
#
# Install this file as /opt/tv-units/dropbear.service. The gawk boot hook
# (/opt/etc/parseinfo.sh) copies every *.service from /opt/tv-units into
# /run/systemd/system and starts it. /opt/tv-units must be root-owned 0700.
#
# The executable lives on the signed /opt VDFS, where the kernel UEP gate rejects
# unsigned ELFs. Rather than copy it into /run, this unit bind-mounts its
# directory under /run for the service only (BindReadOnlyPaths=). /run is outside
# UEP's checked prefixes (/opt:/tmp:/var:/home), so exec from the mount is not
# verified. The mount lives in the service's private mount namespace and is torn
# down when the service stops: no copy, nothing leaked to the host or other
# units. Requires a *relative* multi-call symlink next to the binary:
#   /opt/tv-sshd/bin/dropbearkey -> dropbear

[Unit]
Description=Dropbear SSH server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
BindReadOnlyPaths=/opt/tv-sshd:/run/opt/tv-sshd
ExecStartPre=/bin/sh -c "{ [ -s /opt/tv-sshd/dropbear_ed25519_host_key ] || /run/opt/tv-sshd/bin/dropbearkey -t ed25519 -f /opt/tv-sshd/dropbear_ed25519_host_key; } && chmod 600 /opt/tv-sshd/dropbear_ed25519_host_key"
ExecStart=/run/opt/tv-sshd/bin/dropbear -F -E -D /opt/tv-sshd -r /opt/tv-sshd/dropbear_ed25519_host_key -s -p 22
Restart=always
RestartSec=2

[Install]
# Inert: the boot hook starts this unit.
WantedBy=multi-user.target
