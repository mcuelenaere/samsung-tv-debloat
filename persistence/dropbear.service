# Root-owned extra systemd unit for Dropbear.
#
# Install this file as /opt/tv-units/dropbear.service. The gawk boot hook
# (/opt/etc/parseinfo.sh) copies every *.service from /opt/tv-units into
# /run/systemd/system and starts it. /opt/tv-units must be root-owned 0700.
#
# The executable source is now root-only (but still staged to /run because UEP
# rejects direct execution from writable VDFS).

[Unit]
Description=Dropbear SSH server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c "mkdir -p /run/tv-sshd /opt/tv-sshd && cp -f /opt/tv-sshd/bin/dropbear /run/tv-sshd/dropbearmulti && chmod 755 /run/tv-sshd/dropbearmulti && ln -sf /run/tv-sshd/dropbearmulti /run/tv-sshd/dropbear && ln -sf /run/tv-sshd/dropbearmulti /run/tv-sshd/dropbearkey && { [ -s /opt/tv-sshd/dropbear_ed25519_host_key ] || /run/tv-sshd/dropbearkey -t ed25519 -f /opt/tv-sshd/dropbear_ed25519_host_key; } && chmod 600 /opt/tv-sshd/dropbear_ed25519_host_key"
ExecStart=/run/tv-sshd/dropbear -F -E -D /opt/tv-sshd -r /opt/tv-sshd/dropbear_ed25519_host_key -s -p 22
Restart=always
RestartSec=2

[Install]
# Inert: the boot hook starts this unit.
WantedBy=multi-user.target
