<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://tizen.org/ns/packages" package="org.tvauth.ui" version="0.1.0" api-version="6.5">
  <profile name="tv"/>
  <ui-application appid="org.tvauth.ui" exec="tv-auth-ui" type="capp" multiple="false" taskmanage="true" nodisplay="false" launch_mode="single">
    <label>TV suite</label>
    <icon>org.tvauth.ui.png</icon>
  </ui-application>
  <!-- The dock; tv-patchd makes it the Home key's target. Same executable. -->
  <ui-application appid="org.tvauth.home" exec="tv-auth-ui" type="capp" multiple="false" taskmanage="false" nodisplay="true" launch_mode="single">
    <label>TV suite Home</label>
    <icon>org.tvauth.ui.png</icon>
  </ui-application>
  <privileges>
    <privilege>http://tizen.org/privilege/window.priority.set</privilege>
    <privilege>http://tizen.org/privilege/internet</privilege>
    <privilege>http://tizen.org/privilege/appmanager.launch</privilege>
  </privileges>
</manifest>
